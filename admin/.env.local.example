NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sdílený klíč pro mailovou bránu /api/mail, kterou volá eshop.
# Stejná hodnota jako MAIL_GATEWAY_SECRET v eshopu, min. 24 znaků.
# Bez něj je brána vypnutá a eshop neodešle nic. Vygenerovat: openssl rand -base64 32
MAIL_GATEWAY_SECRET=
