NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prostředí: "production" jen na ostré doméně. Cokoliv jiného (i prázdno) =
# dev → noindex, Disallow: / a site_env="development" v dataLayer.
NEXT_PUBLIC_SITE_ENV=development
# Absolutní URL daného prostředí (canonical, OG, feedy, odkazy v XML).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Tag Manager. Prázdné = GTM se nenačte (lokální vývoj).
NEXT_PUBLIC_GTM_ID=

# Volitelný basic auth pro dev prostředí — aktivní jen když jsou vyplněné obě
# hodnoty a zároveň NEXT_PUBLIC_SITE_ENV != production.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Mapy.com Suggest — napovídání ulice → město + PSČ v checkoutu.
# Klíč jen server-side (nikdy NEXT_PUBLIC_). Bez něj appka běží dál,
# /api/address-suggest jen vrátí prázdný seznam.
# Získání: https://developer.mapy.com → vytvořit projekt → API klíč.
# Stejnou hodnotu přidat ve Vercelu (Production i Preview).
MAPY_API_KEY=

# Podepisování session cookie zákaznického účtu (min. 32 znaků).
# Povinné na Preview/Production. Lokálně bez něj se použije dev-only fallback.
CUSTOMER_SESSION_SECRET=

# Meta Conversions API. Pixel v prohlížeči je v kódu a token sem nepatří.
# Token: Events Manager → Nastavení → Conversions API → Vygenerovat přístupový token.
# Bez něj se serverové konverze neposílají, pixel v prohlížeči funguje i tak.
# META_CAPI_ACCESS_TOKEN=
# Volitelné. Na neprodukci se CAPI odešle jen s tímto kódem (záložka Testovat události).
# Na produkci se ignoruje, ať testovací kód nestrhne ostré kampaně.
# META_CAPI_TEST_EVENT_CODE=

# Mailová brána: veškerou poštu zákazníkům odesílá admin, eshop na SMTP nesahá.
# MAIL_GATEWAY_URL = adresa nasazeného adminu bez lomítka na konci.
# MAIL_GATEWAY_SECRET = stejná hodnota jako v adminu, min. 24 znaků.
# Vygenerovat: openssl rand -base64 32
MAIL_GATEWAY_URL=https://admin.provlajky.cz
MAIL_GATEWAY_SECRET=
