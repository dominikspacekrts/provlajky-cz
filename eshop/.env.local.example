NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prostředí: "production" jen na ostré doméně. Cokoliv jiného (i prázdno) =
# dev → noindex, Disallow: / a site_env="development" v dataLayer.
NEXT_PUBLIC_SITE_ENV=development
# Absolutní URL daného prostředí (canonical, OG, feedy, odkazy v XML).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Tag Manager. Prázdné = GTM se nenačte (lokální vývoj).
NEXT_PUBLIC_GTM_ID=

# Volitelný basic auth pro dev prostředí — aktivní jen když jsou vyplněné obě
# hodnoty a zároveň NEXT_PUBLIC_SITE_ENV != production.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Mapy.com Suggest — napovídání ulice → město + PSČ v checkoutu.
# Klíč jen server-side (nikdy NEXT_PUBLIC_). Bez něj appka běží dál,
# /api/address-suggest jen vrátí prázdný seznam.
# Získání: https://developer.mapy.com → vytvořit projekt → API klíč.
# Stejnou hodnotu přidat ve Vercelu (Production i Preview).
MAPY_API_KEY=

# Podepisování session cookie zákaznického účtu (min. 32 znaků).
# Povinné na Preview/Production. Lokálně bez něj se použije dev-only fallback.
CUSTOMER_SESSION_SECRET=
